+function readArtifactSourceFromRuntime() {
+  const topicId = String(process.env.CATSCO_ARTIFACT_SOURCE_TOPIC_ID || '').trim();
+  const messageId = String(process.env.CATSCO_ARTIFACT_SOURCE_MESSAGE_ID || '').trim();
+  if (!topicId && !messageId) return null;
+  if (!topicId || !/^\d+$/.test(messageId) || !Number.isSafeInteger(Number(messageId)) || Number(messageId) <= 0) {
+    throw new Error('运行时注入的 Artifact 来源不完整或无效；请从 CatsCo 当前对话重新发起发布。');
+  }
+  return { source_topic_id: topicId, source_message_id: Number(messageId) };
+}
+
+async function readExistingArtifact(id) {
+  const result = await call('GET', `/api/artifacts/apps/${encodeURIComponent(id)}`);
+  if (result.status === 404) return { exists: false };
+  if (result.status !== 200) {
+    throw new Error(`检查 Artifact 是否已存在失败 HTTP ${result.status}: ${result.text.slice(0, 300)}`);
+  }
+  return { exists: true, body: result.body };
+}
