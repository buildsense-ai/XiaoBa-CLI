{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pdf-author-editor template registry",
  "type": "object",
  "required": ["version", "default_by_delivery_type", "templates"],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer"
    },
    "default_by_delivery_type": {
      "type": "object",
      "required": ["report", "one-pager", "slides"],
      "properties": {
        "report": { "type": "string" },
        "one-pager": { "type": "string" },
        "slides": { "type": "string" }
      },
      "additionalProperties": true
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "delivery_type", "path", "label", "supports"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "delivery_type": {
            "type": "string",
            "enum": ["report", "one-pager", "slides"]
          },
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "supports": {
            "type": "array",
            "items": { "type": "string" }
          },
          "page": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
